node_modules/
dist/
.env
# Keep lightweight run history; generated artifacts and logs stay local.
runs/*
!runs/.gitkeep
!runs/*/
runs/*/*
!runs/*/manifest.json
!runs/*/gates/
runs/*/gates/*
!runs/*/gates/report.json
.DS_Store
# pnpm's home and store, which CI keeps in the project (PNPM_HOME) for its cache
.pnpm/
.pnpm-store/
# npm pack output, and an .npmrc that may hold a token
*.tgz
.npmrc
