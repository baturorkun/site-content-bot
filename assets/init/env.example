# site-content-bot settings: where the bot runs and its secrets. Copy to .env
# next to the compose file on the host; git ignores .env. What the *site* is
# (its texts, build, checks, version rule, name, deploy jobs) is
# content-bot.config.mjs at the root of the repository, not here.

# The repository over HTTP, e.g. https://gitlab.example.com/group/site.git
# or https://github.com/owner/site.git
CONTENT_BOT_REPO_URL=
# The platform: gitlab or github. Empty: github when the repository's host is
# github.com (or github.<company>), gitlab otherwise.
CONTENT_BOT_PLATFORM=
# The platform's address: the GitLab instance (required there), or GitHub
# (default https://github.com; set it for GitHub Enterprise).
CONTENT_BOT_PLATFORM_URL=
# The project the token and the login are about: group/site on GitLab,
# owner/repo on GitHub.
CONTENT_BOT_PROJECT=
# The token the bot pushes and releases with; git gets it through GIT_ASKPASS,
# never through the URL.
#   GitLab: a project access token, role Maintainer (main accepts pushes from
#           Maintainers), scopes write_repository, read_api and api.
#   GitHub: a fine-grained token on the repository with Contents read/write,
#           Actions read and Metadata read, or a classic token with repo.
CONTENT_BOT_TOKEN=
# The bot as the browser reaches it, e.g. http://bot.example.com:8290;
# the platform sends the login back to <it>/auth/callback.
CONTENT_BOT_URL=
# The OAuth application (GitLab: Settings > Applications, confidential, scope
# read_user; GitHub: Settings > Developer settings > OAuth Apps), with the
# callback URL <CONTENT_BOT_URL>/auth/callback.
CONTENT_BOT_OAUTH_ID=
CONTENT_BOT_OAUTH_SECRET=

# Optional, with their defaults.
# The access a person needs to come in: 30 = Developer on GitLab, the write
# role on GitHub (40 = Maintainer / maintain, 50 = Owner / admin).
#CONTENT_BOT_MIN_ACCESS=30
# The model the claude CLI answers with.
#CONTENT_BOT_MODEL=claude-opus-5-5
# The port the bot listens on (the compose file publishes 8290).
#CONTENT_BOT_PORT=8290
# Where the clone and the copies live (the /data volume in the container).
#CONTENT_BOT_REPO_DIR=/data/repo
#CONTENT_BOT_SITE_DIR=/data/site
# The claude executable.
#CLAUDE_EXECUTABLE=claude
