# site-content-bot settings: where the bot runs and its secrets. Copy to .env
# next to the compose file on the host; git ignores .env. What the *site* is
# (its texts, build, checks, version rule, name) is content-bot.config.mjs at
# the root of the repository, not here.

# The repository over HTTP, e.g. https://gitlab.example.com/group/site.git
CONTENT_BOT_REPO_URL=
# A project access token of the site's project, role Maintainer (main accepts
# pushes from Maintainers), scopes write_repository, read_api and api (for the
# releases); git gets it through GIT_ASKPASS, never through the URL.
CONTENT_BOT_GITLAB_TOKEN=
# GitLab itself: the login, the pipeline status, the releases, e.g. https://gitlab.example.com
GITLAB_URL=
# The project the token and the login are about, e.g. group/site
CONTENT_BOT_GITLAB_PROJECT=
# The bot as the browser reaches it, e.g. http://bot.example.com:8290;
# GitLab sends the login back to <it>/auth/callback.
CONTENT_BOT_URL=
# The GitLab OAuth application (Settings > Applications: redirect URI
# <CONTENT_BOT_URL>/auth/callback, confidential, scope read_user).
CONTENT_BOT_OAUTH_ID=
CONTENT_BOT_OAUTH_SECRET=

# Optional, with their defaults.
# The project access level a person needs to come in (30 = Developer).
#CONTENT_BOT_MIN_ACCESS=30
# The model the claude CLI answers with.
#CONTENT_BOT_MODEL=claude-opus-5-5
# The port the bot listens on (the compose file publishes 8290).
#CONTENT_BOT_PORT=8290
# Where the clone and the copies live (the /data volume in the container).
#CONTENT_BOT_REPO_DIR=/data/repo
#CONTENT_BOT_SITE_DIR=/data/site
# The claude executable.
#CLAUDE_EXECUTABLE=claude
