{
  "name": "site-content-bot",
  "version": "0.2.0",
  "description": "A chat that reads a website's repository and changes its texts: proposed edits, Apply pushes to main, Release ships to production.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "site-content-bot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "factory": "factory",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "template:check": "node scripts/template-check.mjs"
  },
  "devDependencies": {
    "aifactory-cli": "0.159.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.11.0"
  }
}
